{
  "name": "vast-axi",
  "version": "0.2.0",
  "description": "Agent-ergonomic wrapper around the vast.ai CLI (AXI standard, TOON output)",
  "type": "module",
  "private": true,
  "bin": {
    "vast-axi": "./dist/bin/vast-axi.js"
  },
  "files": [
    "dist",
    "skills/vast-axi",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:skill": "tsx scripts/build-skill.ts",
    "prepack": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "pnpm build && vitest run --config vitest.live.config.ts",
    "dev": "tsx bin/vast-axi.ts",
    "lint": "eslint .",
    "format:check": "prettier --check \"{bin,src,tests,scripts}/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffrymahbuubi/vast-axi.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@toon-format/toon": "^2.1.0",
    "axi-sdk-js": "^0.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "js-tiktoken": "^1.0.21",
    "prettier": "^3.8.1",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.0.0"
  }
}
